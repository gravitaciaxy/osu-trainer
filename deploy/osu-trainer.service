# systemd-юнит сайта osu!drill (серверный режим за nginx).
# Установка: см. deploy/README.md
[Unit]
Description=osu!drill website (server mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osutrainer
Group=osutrainer
WorkingDirectory=/opt/osu-trainer
ExecStart=/usr/bin/python3 /opt/osu-trainer/ui.py --server --port 3002 --public-url https://osu.gravitacia.art
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# токен бота и чат для обратной связи (пишет deploy/telegram-setup.sh; файла может не быть)
EnvironmentFile=-/etc/osu-trainer.env
MemoryMax=450M
CPUQuota=80%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/osu-trainer/cache

[Install]
WantedBy=multi-user.target
